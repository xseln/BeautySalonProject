@model BeautySalonProject.Areas.Client.ViewModels.Appointments.ClientBookVm

@{
    ViewData["Title"] = "Запази час";
    // Генерираме днешната дата във формат yyyy-MM-dd за календара
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container mt-5">
    <div class="sh-main-wrapper" style="background-color: #F9F6F2; border: 2px solid #D4AF37; border-radius: 20px; padding: 40px;">
        <div class="row">

            <!-- ЛЯВА КОЛОНА -->
            <div class="col-md-7">
                <h2 class="mb-4" style="font-family: 'Playfair Display', serif; color: #4A3728;">Запази своя час</h2>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="small fw-bold text-uppercase">Категория</label>
                        <select id="categorySelect" class="form-select border-gold shadow-none">
                            <option value="">-- избери --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                    <option value="@cat.Value">@cat.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="small fw-bold text-uppercase">Услуга</label>
                        <select id="serviceSelect" class="form-select border-gold shadow-none">
                            <option value="">-- първо избери категория --</option>
                        </select>
                    </div>
                </div>

                <!-- ДОБАВЕНО: ВАРИАНТ (Без това не излизат часовете) -->
                <div class="mb-4">
                    <label class="small fw-bold text-uppercase">Вариант на услугата</label>
                    <select id="variantSelect" class="form-select border-gold shadow-none">
                        <option value="">-- първо избери услуга --</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="small fw-bold text-uppercase">Специалист</label>
                    <div class="sh-employee-grid d-flex flex-wrap gap-2">
                        @foreach (var e in Model.Employees)
                        {
                                <div class="sh-employee-card" 
                                     style="background: #ffffff; border: 1px solid #D4AF37; border-radius: 8px; padding: 10px 15px; cursor: pointer; min-width: 140px; text-align: center;"
                                     onclick="selectEmployee(this, @e.EmployeeId, '@e.Name')">
                                    <span class="sh-emp-name" style="display: block; font-family: 'Playfair Display', serif; font-weight: bold;">@e.Name</span>
                                       <small class="sh-emp-role" style="color: #C5A059; font-size: 0.75rem; font-weight: 500; display: block; margin-top: 3px;">
                                    @(string.IsNullOrEmpty(e.JobTitle) ? "Фризьор" : e.JobTitle)
                                       </small>
                                </div>
                        }
                    </div>
                    <!-- Скритото поле за ID-то на служителя -->
                    <input type="hidden" id="employeeSelectHidden" name="EmployeeId" />
                 </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="small fw-bold text-uppercase">Дата</label>
                        <input asp-for="Date" type="date" id="dateInput" 
                               class="form-control border-gold" 
                               min="@today" 
                               value="@today" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="small fw-bold text-uppercase">Свободни часове</label>
                    <div id="slotsBox" class="d-flex flex-wrap gap-2 pt-2">
                        <small class="text-muted">Избери вариант, специалист и дата...</small>
                    </div>
                    <input type="hidden" id="startTimeHidden" asp-for="StartTime" />
                </div>
            </div>

            <!-- ДЯСНА КОЛОНА (Обобщение) -->
            <div class="col-md-5">
                <div class="p-4" style="background: rgba(255,255,255,0.5); border-radius: 15px; border: 1px dashed #D4AF37;">
                    <h5 class="mb-4 text-center" style="font-family: 'Playfair Display', serif;">Твоят избор</h5>

                    <ul class="list-unstyled">
                        <li class="d-flex justify-content-between mb-2">
                            <span>Специалист:</span> <span id="infoEmployeeName" class="fw-bold">-</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span>Услуга:</span> <span id="infoServiceName" class="fw-bold">-</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span>Дата:</span> <span id="infoDate" class="fw-bold">@DateTime.Now.ToString("dd.MM.yyyy")</span>
                        </li>
                        <li class="d-flex justify-content-between mb-3">
                            <span>Час:</span> <span id="infoTime" class="fw-bold">-</span>
                        </li>
                        <li class="d-flex justify-content-between border-top pt-3">
                            <span class="h5">Общо:</span> 
                            <span class="h5 text-dark"><span id="infoPrice">0</span>€</span>
                        </li>
                    </ul>

                    <form asp-action="Book" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <!-- Тези ID-та трябва да съвпадат с JavaScript-а за финално пращане -->
                        <input type="hidden" name="VariantId" id="finalVariantId" />
                        <input type="hidden" name="EmployeeId" id="finalEmployeeId" />
                        <input type="hidden" name="Date" id="finalDate" value="@today" />
                        <input type="hidden" name="StartTime" id="finalStartTime" />

                        <button type="submit" class="btn w-100 py-3"
        style="background: linear-gradient(to right, #d8b27a, #b48a4a); color: #fff; font-family: 'Playfair Display', serif; font-weight: bold; letter-spacing: 1px; border-radius: 5px;">
    ПОТВЪРДИ РЕЗЕРВАЦИЯТА
</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            // ДЕФИНИРАМЕ ФУНКЦИЯТА ТУК, ЗА ДА Е ГЛОБАЛНА
            function selectEmployee(element, id, name) {
                console.log("Клик върху служител:", name);

                // 1. Маркираме визуално
                document.querySelectorAll('.sh-employee-card').forEach(card => {
                    card.style.border = "1px solid #D4AF37";
                    card.style.backgroundColor = "#ffffff";
                });
                element.style.border = "2px solid #3E2723";
                element.style.backgroundColor = "#FFFDF9";

                // 2. Попълваме полетата (Провери дали ID-тата съвпадат точно!)
                const input1 = document.getElementById("employeeSelectHidden");
                const input2 = document.getElementById("finalEmployeeId");
                const infoName = document.getElementById("infoEmployeeName");

                if (input1) input1.value = id;
                if (input2) input2.value = id;
                if (infoName) infoName.textContent = name;

                // 3. Викаме зареждането на часове (ако е дефинирано в client-booking.js)
                if (window.loadAvailableSlots) {
                    window.loadAvailableSlots();
                }
            }
        </script>

        <script src="~/js/client-booking.js"></script>
}
