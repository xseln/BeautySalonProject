@model BeautySalonProject.Areas.Staff.ViewModels.Profile.EditProfileVm

@{
    ViewData["Title"] = "Моят профил";
    Layout = "~/Areas/Staff/Views/Shared/_StaffLayout.cshtml";
}

<div class="container mt-5">
    <div class="profile-card mx-auto">

         <h3 class="text-center mb-4">✨ Моят профил</h3>

        <form method="post">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Име</label>
                    <input asp-for="FirstName" class="form-control gold-input" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Фамилия</label>
                    <input asp-for="LastName" class="form-control gold-input" />
                </div>
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input asp-for="Email" class="form-control gold-input" />
            </div>

            <div class="mb-3">
                <label>Телефон</label>
                <input asp-for="PhoneNumber" class="form-control gold-input" />
            </div>

            <hr />

            <h5 class="mt-3">Смяна на парола</h5>

            <div class="mb-3">
                <input asp-for="CurrentPassword" type="password" placeholder="Стара парола" class="form-control gold-input" />
            </div>

            <div class="mb-3">
                <input asp-for="NewPassword" type="password" placeholder="Нова парола" class="form-control gold-input" />
            </div>

            <button type="submit" class="btn gold-btn w-100 mt-3">
                Запази промените
            </button>

        </form>
    </div>
</div>